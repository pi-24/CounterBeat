# Copy to .env.local and fill in to use real accounts and the shared,
# verified leaderboard.  Leave both unset and the site runs entirely in the
# browser's local storage (fine for development).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: error reporting.  Leave empty to disable.
VITE_SENTRY_DSN=

# Optional: shown as the release in error reports.  Vercel can set this from
# the commit SHA (e.g. VITE_APP_VERSION=$VERCEL_GIT_COMMIT_SHA).
VITE_APP_VERSION=
